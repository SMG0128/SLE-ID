                            this.observeComponentCreation2((elmtId, isInitialRender) => {
                                Divider.create();
                                Divider.color('rgba(199, 196, 215, 0.1)');
                                Divider.margin({ left: Theme.SPACING_LG, right: Theme.SPACING_LG });
                            }, Divider);
