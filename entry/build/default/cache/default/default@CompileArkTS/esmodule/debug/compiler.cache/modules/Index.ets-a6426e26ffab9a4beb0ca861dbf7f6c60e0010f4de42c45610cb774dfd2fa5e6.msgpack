        }
        if (this.invitationPreview.usageMode === AuthorizationUsageMode.UNLIMITED) {
            return this.language === 'zh' ? 'ä¸é™æ¬¡æ•°' : 'Unlimited';
        }
        return this.language === 'zh' ? `${this.invitationPreview.usageLimit} æ¬¡` :
            `${this.invitationPreview.usageLimit} uses`;
    }
    invitationConfirmationText() {
        if (this.invitationPreview && this.invitationPreview.adminConfirmationRequired) {
            return this.language === 'zh' ? 'ç®¡ç†æ–¹è¦æ±‚äºŒæ¬¡ç¡®è®¤' : 'Required by administrator';
        }
        return this.language === 'zh' ? 'å¯ç”±ç”¨æˆ·è‡ªè¡Œå¼€å¯' : 'Optional';
    }
    invitationPhoneSubstituteText() {
        if (this.invitationPreview && this.invitationPreview.phoneSubstituteAllowed) {
            return this.language === 'zh' ? 'å…è®¸' : 'Allowed';
        }
        return this.language === 'zh' ? 'ä¸å…è®¸' : 'Not allowed';
    }
    invitationOfflineText() {
        if (this.invitationPreview && this.invitationPreview.offlineAllowed) {
