        }
        if (this.invitationPreview.alertPolicy === AuthorizationAlertPolicy.NOTIFY_ON_USE) {
            return this.language === 'zh' ? 'ä½¿ç”¨æ—¶æé†’' : 'Notify on use';
        }
        return this.language === 'zh' ? 'é»˜è®¤' : 'Default';
